# Copy to .env (gitignored) and fill in. Never commit real values:
# `uv run python -m bot.verify` fails if any .env value appears in a publishable file.

# Your bot account's API token: metaculus.com -> bot account -> settings.
METACULUS_TOKEN=

# An OpenRouter key: Metaculus's donated-credit key, or a personal one.
OPENROUTER_API_KEY=

# Optional: your own OpenRouter key, for models the key above cannot reach.
# Metaculus's donated keys allow only OpenAI, Anthropic and Google, so the
# roster's x-ai/* (Grok) runs go here. Unset, Grok is dropped from the roster.
OPENROUTER_PERSONAL_KEY=

# Optional: email when a key runs low, runs out, or is topped up.
# A Gmail app password (Google account -> Security -> App passwords), not the
# account password. ALERT_EMAIL_TO defaults to ALERT_SMTP_USER.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional. Without these, research runs on the models' web search only.
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=

# Optional overrides. Defaults: bot/forecast.py DEFAULT_FORECAST_MODELS / DEFAULT_RESEARCH_MODEL.
# METAC_FORECAST_MODELS=anthropic/claude-fable-5,openai/gpt-5.5,google/gemini-3.8-flash
# METAC_RESEARCH_MODEL=anthropic/claude-sonnet-5:online
